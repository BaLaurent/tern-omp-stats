--!strict
local check = require("./check")
local fmt = require("../lib/fmt")

check.eq({ fmt.count(842), fmt.count(12345), fmt.count(4560000), fmt.count(2.5e9), fmt.count(nil) }, { "842", "12.3k", "4.6M", "2.5G", "—" }, "counts scale to k/M/G")
check.eq(fmt.count(123456), "123k", "six digits drop the decimal")
check.eq({ fmt.money(0.4), fmt.money(12.3), fmt.money(1234), fmt.money(nil) }, { "$0.40", "$12.30", "$1.2k", "—" }, "money")
check.eq({ fmt.money(-0.01), fmt.money(-0.001), fmt.money(-1500) }, { "-$0.01", "$0.00", "-$1.5k" }, "negative money keeps the sign in front, and rounds to zero without one")
check.eq({ fmt.pct(0.1234), fmt.pct(nil) }, { "12.3%", "—" }, "percentages")
check.eq({ fmt.ms(420), fmt.ms(3400), fmt.ms(nil) }, { "420 ms", "3.4 s", "—" }, "milliseconds")
check.eq({ fmt.span(45000), fmt.span(720000), fmt.span(11100000) }, { "45 s", "12 min", "3 h 05" }, "durations")

local text, dir = fmt.delta(150, 100)
check.eq({ text, dir }, { "+50%", 1 }, "increase")
text, dir = fmt.delta(50, 100)
check.eq({ text, dir }, { "-50%", -1 }, "decrease")
text, dir = fmt.delta(100.2, 100)
check.eq({ text, dir }, { "±0%", 0 }, "rounding to zero is no change")
text, dir = fmt.delta(5, 0)
check.eq({ text, dir }, { nil, 0 }, "no previous base: no delta, never a division by zero")
check.eq(fmt.ratio(1, 0), nil, "zero denominator has no ratio")
check.eq({ fmt.num(nil), fmt.num("x"), fmt.num(3) }, { 0, 0, 3 }, "missing cells read as zero")
check.eq(fmt.folder("/run-media-octopusman-Games-kairon/"), "run-media-octopusman-Games-kairon", "project slashes trimmed")
check.eq(fmt.folder(nil), "—", "missing project")
